    "@nestjs/axios": "3.0.2",
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/common": "10.3.9",
    "@nestjs/config": "3.2.2",
    "@nestjs/core": "10.3.9",
    "@nestjs/graphql": "^12.1.0",
    "@nestjs/mongoose": "10.0.6",
    "@nestjs/platform-express": "10.3.9",
    "@nestjs/swagger": "7.3.1",
    "@nestjs/typeorm": "10.0.2",
    "@types/axios": "0.14.0",
    "@types/redis": "4.0.11",
