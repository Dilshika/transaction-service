    "graphql": "16.8.1",
    "helmet": "^8.1.0",
    "ioredis": "5.4.1",
    "joi": "17.13.1",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.17.21",
    "luxon": "3.4.4",
    "mongoose": "8.4.1",
    "nestjs-pino": "4.1.0",
    "pg": "8.11.5",
    "pino": "9.1.0",
